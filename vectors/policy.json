{
 "description": "Policies only tighten (spec 5). Digests are SHA-256 over canonical JSON.",
 "cases": [
  {
   "op": "tighten",
   "a": "schedule",
   "b": "summarize",
   "expect": {
    "EMAIL": "drop",
    "OTP": "drop",
    "DATE": "shift",
    "PERSON": "fake",
    "ORG": "fake",
    "LOCATION": "generalize",
    "MONEY": "keep",
    "CARD": "drop"
   }
  },
  {
   "op": "with_rules",
   "base": "strict",
   "rules": {
    "OTP": {
     "action": "keep"
    }
   },
   "error": "OTP: 'handle' cannot be loosened to 'keep'"
  },
  {
   "op": "with_rules",
   "base": "strict",
   "rules": {
    "PERSON": {
     "action": "drop"
    }
   },
   "expect": {
    "PERSON": "drop"
   }
  },
  {
   "op": "digest",
   "profile": "strict",
   "expect": "sha-256:jdAfZhm1V31oy_whaohi79RK1PdPATX2cypcy_o5QRo"
  },
  {
   "op": "digest",
   "profile": "draft_reply",
   "expect": "sha-256:eMHbDH4crJqBeQmt6Fdg39C0zTqRSOwpPL50if1t0Zk"
  },
  {
   "op": "digest",
   "profile": "secrets_only",
   "expect": "sha-256:i83G8wI8LDI9mLFkxXBv4QrFwZ_ffSTvbtHZvfb0sR0"
  }
 ]
}
