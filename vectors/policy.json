{
 "description": "Policies only tighten (spec 5). Digests are SHA-256 over canonical JSON.",
 "cases": [
  {
   "op": "tighten",
   "a": "schedule",
   "b": "summarize",
   "expect": {
    "EMAIL": "drop",
    "OTP": "drop",
    "DATE": "shift",
    "PERSON": "fake",
    "ORG": "fake",
    "LOCATION": "generalize",
    "MONEY": "keep",
    "CARD": "drop"
   }
  },
  {
   "op": "with_rules",
   "base": "strict",
   "rules": {
    "OTP": {
     "action": "keep"
    }
   },
   "error": "OTP: 'handle' cannot be loosened to 'keep'"
  },
  {
   "op": "with_rules",
   "base": "strict",
   "rules": {
    "PERSON": {
     "action": "drop"
    }
   },
   "expect": {
    "PERSON": "drop"
   }
  },
  {
   "op": "digest",
   "profile": "strict",
   "expect": "sha-256:Kup3k5qb2ghiy_CIv29qnu3bCHcZDFkWye3EIfRvN-Y"
  },
  {
   "op": "digest",
   "profile": "draft_reply",
   "expect": "sha-256:3pyGzM1KRJVM1phUKj79n8eCEabjJFBVFiQs8TOba_8"
  },
  {
   "op": "digest",
   "profile": "secrets_only",
   "expect": "sha-256:YuAjhIt4ssnsG-isnffVeo36XckdGkAZjBSKHXeOUQw"
  }
 ]
}
