{
 "description": "Policies only tighten (spec 5). Digests are SHA-256 over canonical JSON.",
 "cases": [
  {
   "op": "tighten",
   "a": "schedule",
   "b": "summarize",
   "expect": {
    "EMAIL": "drop",
    "OTP": "drop",
    "DATE": "shift",
    "PERSON": "fake",
    "ORG": "fake",
    "LOCATION": "generalize",
    "MONEY": "keep",
    "CARD": "drop"
   }
  },
  {
   "op": "with_rules",
   "base": "strict",
   "rules": {
    "OTP": {
     "action": "keep"
    }
   },
   "error": "OTP: 'handle' cannot be loosened to 'keep'"
  },
  {
   "op": "with_rules",
   "base": "strict",
   "rules": {
    "PERSON": {
     "action": "drop"
    }
   },
   "expect": {
    "PERSON": "drop"
   }
  },
  {
   "op": "digest",
   "profile": "strict",
   "expect": "sha-256:rg727FeKB71xaWRmAQEoNBqEw4IJdivZD-MctOxB4Og"
  },
  {
   "op": "digest",
   "profile": "draft_reply",
   "expect": "sha-256:FgzgYGSHUaikxSzqt4ghBLeU7yQP_grXs4w0ZL2uKG4"
  },
  {
   "op": "digest",
   "profile": "secrets_only",
   "expect": "sha-256:paCJRUr2OrPuh1Rl7FNsURtm6TbLwvtxtIn5v2qheng"
  }
 ]
}
