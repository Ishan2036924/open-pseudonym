{
 "opn": "0.1",
 "type": "policy",
 "id": "strict",
 "description": "Everything personal is faked or handled; dates shift together.",
 "rules": {
  "PERSON": {
   "action": "fake",
   "keep_gender": true
  },
  "EMAIL": {
   "action": "fake"
  },
  "PHONE": {
   "action": "fake"
  },
  "ADDRESS": {
   "action": "fake"
  },
  "URL": {
   "action": "fake"
  },
  "IP_ADDRESS": {
   "action": "fake"
  },
  "ORG": {
   "action": "fake"
  },
  "LOCATION": {
   "action": "fake"
  },
  "DATE": {
   "action": "shift"
  },
  "MONEY": {
   "action": "keep"
  },
  "ID": {
   "action": "tag"
  },
  "CARD": {
   "action": "handle",
   "ask": true
  },
  "IBAN": {
   "action": "handle",
   "ask": true
  },
  "ROUTING": {
   "action": "handle",
   "ask": true
  },
  "BANK_ACCOUNT": {
   "action": "handle",
   "ask": true
  },
  "SSN": {
   "action": "handle",
   "ask": true
  },
  "API_KEY": {
   "action": "handle"
  },
  "PASSWORD": {
   "action": "handle"
  },
  "OTP": {
   "action": "handle",
   "uses": 1,
   "ttl_s": 600
  }
 },
 "default": {
  "action": "tag"
 },
 "allow": []
}
