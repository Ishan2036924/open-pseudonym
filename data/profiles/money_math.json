{
 "opn": "0.1",
 "type": "policy",
 "id": "money_math",
 "description": "Budgets, invoices and totals. Amounts stay exact; who and where are faked.",
 "rules": {
  "PERSON": {
   "action": "fake",
   "keep_gender": true
  },
  "EMAIL": {
   "action": "fake"
  },
  "PHONE": {
   "action": "fake"
  },
  "ADDRESS": {
   "action": "fake"
  },
  "URL": {
   "action": "fake"
  },
  "IP_ADDRESS": {
   "action": "fake"
  },
  "ORG": {
   "action": "fake"
  },
  "LOCATION": {
   "action": "fake"
  },
  "DATE": {
   "action": "shift"
  },
  "MONEY": {
   "action": "keep"
  },
  "CARD": {
   "action": "handle"
  },
  "IBAN": {
   "action": "handle"
  },
  "ROUTING": {
   "action": "handle"
  },
  "BANK_ACCOUNT": {
   "action": "handle"
  },
  "SSN": {
   "action": "drop"
  },
  "API_KEY": {
   "action": "drop"
  },
  "PASSWORD": {
   "action": "drop"
  },
  "OTP": {
   "action": "drop"
  }
 },
 "default": {
  "action": "tag"
 },
 "allow": []
}