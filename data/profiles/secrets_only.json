{
 "opn": "0.1",
 "type": "policy",
 "id": "secrets_only",
 "description": "Lightest level: only secrets are hidden (as handles). Everything else reaches the model as is.",
 "rules": {
  "CARD": {
   "action": "handle",
   "ask": true
  },
  "IBAN": {
   "action": "handle",
   "ask": true
  },
  "ROUTING": {
   "action": "handle",
   "ask": true
  },
  "BANK_ACCOUNT": {
   "action": "handle",
   "ask": true
  },
  "SSN": {
   "action": "handle",
   "ask": true
  },
  "API_KEY": {
   "action": "handle"
  },
  "PASSWORD": {
   "action": "handle"
  },
  "OTP": {
   "action": "handle",
   "uses": 1,
   "ttl_s": 600
  },
  "USERNAME": {
   "action": "keep"
  }
 },
 "default": {
  "action": "keep"
 },
 "allow": []
}
